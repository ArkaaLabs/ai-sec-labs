# Copy to .env and edit if a port clashes. Defaults are fine for most setups.

# Catalog launcher
CATALOG_PORT=8088

# Shared model server
OLLAMA_PORT=11434
# Track default. Needs ~16GB RAM. Low-RAM fallback: qwen2.5:3b-instruct
OLLAMA_MODEL=llama3.1:8b

# Lab host
RANGE_PORT=8081

# Cohort secrets. Leave blank for the public defaults; set BOTH for a paid cohort,
# then re-seal:  ARKAA_PEPPER=... docker compose run --rm range python -m tools.sealtool reseal-flags
ARKAA_PEPPER=
ARKAA_SOLUTION_KEY=
